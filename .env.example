# Frontend (Vite) — copy to .env.local for local work. Never commit secrets.
# GitHub Pages build should leave VITE_STORE_ENABLED unset/false until launch.

# Show Shop nav + cart icon
VITE_STORE_ENABLED=false

# Include clearly labelled [SAMPLE] catalogue products (local UI only)
VITE_STORE_SAMPLE_CATALOGUE=false

# Cloudflare Worker origin for orders/payments (no trailing slash)
# Example local: http://127.0.0.1:8787
# Example prod:  https://vesa-storefront-api.<account>.workers.dev
VITE_API_BASE_URL=

# GitHub Pages build (CI)
# GH_PAGES=1
# VITE_BASE_PATH=/
